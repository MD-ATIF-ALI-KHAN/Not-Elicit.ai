# Copy this file to .env.local and fill in ONE AI provider.
# Not-Elicit.ai uses the first key it finds (Anthropic, Gemini, Groq, OpenRouter),
# or the provider named in AI_PROVIDER.

# --- Free options ------------------------------------------------------------

# Google Gemini (free tier): https://aistudio.google.com/apikey
# Default model gemini-3.5-flash-lite (15 requests/min free). For better writing
# at 5 requests/min, add: AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# Groq (free tier, very fast): https://console.groq.com/keys
# GROQ_API_KEY=

# OpenRouter (has free models; set AI_MODEL to one ending in ":free"):
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# AI_MODEL=

# Ollama (runs models on your own computer, no key): https://ollama.com
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1

# --- Paid option ---------------------------------------------------------------

# Anthropic Claude (best quality; native citations and PDF reading):
# https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=

# --- Advanced ------------------------------------------------------------------

# Force a provider: anthropic | gemini | groq | openrouter | ollama | openai-compatible
# AI_PROVIDER=
# Override the provider's default model.
# AI_MODEL=
# Any other OpenAI-compatible server (LM Studio, vLLM, Together, ...):
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:1234/v1
# AI_API_KEY=
# Characters of full text sent per uploaded PDF to non-Claude models (default 60000).
# AI_MAX_PDF_CHARS=60000
# Optional cap on AI requests per minute (useful on strict free tiers).
# AI_REQUESTS_PER_MINUTE=

# --- Paper search ----------------------------------------------------------------

# Optional but recommended: a free OpenAlex key gives you your own daily budget
# instead of sharing the anonymous one. https://openalex.org/settings/api
OPENALEX_API_KEY=
# Optional: contact email sent to OpenAlex with each request.
OPENALEX_MAILTO=

# Optional: where the SQLite database and uploaded PDFs are stored.
# NOT_ELICIT_DATA_DIR=./data

# --- Security (for shared or public servers) ---------------------------------------

# Close registration once your own account exists (the first account can always
# be created). Recommended if anyone else can reach your server.
# DISABLE_SIGNUPS=true
